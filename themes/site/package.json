{
  "name": "site",
  "version": "3.0.12",
  "description": "アクセシビリティに配慮した実用的なテーマです。豊富なテンプレートを備えており、企業サイトとしてそのままご利用いただけます。",
  "keywords": [
    "CMS",
    "a-blog cms"
  ],
  "browserslist": [
    "baseline widely available"
  ],
  "config": {
    "local": "localhost",
    "theme": "site"
  },
