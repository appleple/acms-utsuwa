    "autoprefixer": "^10.5.4",
    "babel-loader": "^10.1.1",
    "babel-plugin-polyfill-corejs3": "^1.0.0",
    "browserslist": "^4.28.1",
    "core-js": "^3.50.0",
    "css-loader": "^7.1.4",
    "eslint": "^10.9.1",
    "eslint-import-resolver-webpack": "^0.13.11",
